{
  "project_type": "single",
  "services": {
    "django_app": {
      "path": ".",
      "tech_stack": ["python", "django", "alpinejs", "htmx"],
      "port": 8000,
      "dev_command": "python manage.py runserver",
      "test_command": "python manage.py test"
    }
  },
  "infrastructure": {
    "docker": true,
    "database": "postgresql"
  },
  "conventions": {
    "linter": "ruff",
    "formatter": "black",
    "testing": "django.test",
    "frontend": "alpinejs + htmx"
  }
}
