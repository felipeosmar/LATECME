{
  "project_type": "single",
  "services": {
    "backend": {
      "path": ".",
      "tech_stack": ["python", "django", "postgresql"],
      "port": 8000,
      "dev_command": "python manage.py runserver",
      "test_command": "python manage.py test apps.materials"
    }
  },
  "infrastructure": {
    "docker": true,
    "database": "postgresql",
    "docker_compose": true
  },
  "conventions": {
    "testing": "django.test.TestCase",
    "models_location": "apps/*/models.py",
    "views_location": "apps/*/views.py",
    "query_optimization": "Use select_related for ForeignKey, prefetch_related for ManyToMany and reverse ForeignKey"
  }
}
