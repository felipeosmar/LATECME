{
  "project_type": "single",
  "services": {
    "backend": {
      "path": ".",
      "tech_stack": ["python", "django", "postgresql"],
      "python_version": ">=3.10",
      "port": 8000,
      "dev_command": "python manage.py runserver",
      "test_command": "python manage.py test",
      "django_apps": [
        "apps.core",
        "apps.accounts",
        "apps.materials",
        "apps.inventory",
        "apps.production",
        "apps.labels",
        "apps.purchasing"
      ],
      "settings_module": "config.settings"
    }
  },
  "infrastructure": {
    "docker": true,
    "docker_compose": true,
    "database": "postgresql",
    "uses_poetry": true,
    "ci_cd": false
  },
  "conventions": {
    "linter": "none",
    "formatter": "none",
    "type_checker": "none",
    "testing": "django_test",
    "import_order": "django_first_then_local",
    "docstring_style": "mixed_portuguese_english"
  },
  "existing_config_files": {
    "pyproject.toml": "exists_minimal",
    "requirements.txt": "exists",
    "manage.py": "exists",
    "docker-compose.yml": "exists"
  }
}
