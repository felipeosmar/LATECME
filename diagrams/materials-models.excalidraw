    {
      "id": "material-fields",
      "type": "text",
      "x": 365,
      "y": 150,
      "width": 310,
      "height": 300,
      "text": "code: CharField(20) unique\n  regex: ^[A-Z]{2,4}[A-Z0-9]+$\n  ex: AL7075, TI6AL4V\n\nname: CharField(200)\nmaterial_type: CharField(10)\n  AL|TI|SS|IN|CO|CU|NI|OTHER\n\ndensity: Decimal(5,3) g/cm3\n  validators: 0.1 - 25.0\n\nmelting_point: Decimal(6,1) C\nspecifications: JSONField\nrequires_certificate: Bool\nstorage_requirements: Text\nsafety_notes: Text\ncategory: FK -> MaterialCategory\n\n-- Metodos --\nget_main_suppliers() -> top 3\nget_best_price() -> Decimal",
      "fontSize": 12,
      "fontFamily": 3,
