    {
      "id": "workflow-content",
      "type": "text",
      "x": 120,
      "y": 425,
      "width": 240,
      "height": 180,
      "text": "1. Usuario se registra\n   status = 'pending'\n\n2. Admin aprova/rejeita\n   status = 'approved'\n   approved_by = admin\n   approved_at = now()\n\n3. Acesso ao sistema:\n   can_access_system()\n   = approved + role + active",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "version": 2,
      "versionNonce": 679839159,
      "index": "aJ",
      "isDeleted": false,
      "strokeStyle": "solid",
      "angle": 0,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1768920506088,
      "link": null,
      "locked": false,
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Usuario se registra\n   status = 'pending'\n\n2. Admin aprova/rejeita\n   status = 'approved'\n   approved_by = admin\n   approved_at = now()\n\n3. Acesso ao sistema:\n   can_access_system()\n   = approved + role + active",
      "autoResize": true,
      "lineHeight": 1.2587412587412588
    },
